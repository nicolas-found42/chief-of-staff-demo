{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"],
    },
    "apps/server": {
      "project": ["src/**/*.ts"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
    },
    "tests": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.spec.ts", "e2e/start-server.mjs"],
      "project": ["src/**/*.ts", "e2e/**/*.{ts,mjs}"],
    },
  },
}
