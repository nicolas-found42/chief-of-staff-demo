          "threadId": "yk5itn_each",
          "outputSchema": {
            "type": "object",
            "properties": {
              "agg_ou028y": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "agg_ou028y"
            ]
          }
        },
        {
          "stepId": "aase0r",
          "stepType": "builtin.sendEmailNotification",
          "title": "Send email to yourself",
          "adapter": "notification",
          "inputs": [
            {
              "input": "subject",
              "type": "string",
              "value": "Transcription Processed - {{trigger.Title}}"
            },
            {
              "input": "body",
              "type": "string",
              "value": "The following transcription has been processed:\nTitle: {{trigger.Title}}\nLink: {{trigger.File URL}}\nCreation Time: {{trigger.Creation time}}\n\nTasks extracted:\n{{#each task in eitxht}}\n- {{task.Task name}} ({{task.Task type}})\n{{/each}}"
            }
          ],
          "outputSchema": {
            "type": "object",
            "properties": {
              "Notification URL": {
                "type": "string"
              }
            },
            "required": [
              "Notification URL"
            ]
          }
        }
      ]
    },
    {
