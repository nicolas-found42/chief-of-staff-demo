{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"],
    },
    "apps/server": {
      // The three Google provider factory files below are the production seams
      // for the Meeting Brief real-provider wave — kept for issue #103 (real
      // Calendar provider + owner email in the production bootstrap).
      // main.ts wires them when that wave lands; do not delete.
      "entry": [
        "src/modules/meeting-brief-generator/google/calendarHistory.ts",
        "src/modules/meeting-brief-generator/google/drive.ts",
        "src/modules/meeting-brief-generator/google/gmailDelivery.ts",
      ],
      "project": ["src/**/*.ts"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
    },
    "tests": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.spec.ts", "e2e/start-server.mjs"],
      "project": ["src/**/*.ts", "e2e/**/*.{ts,mjs}"],
    },
  },
}
