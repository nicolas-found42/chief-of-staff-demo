{
  "name": "chief-of-staff-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local web app that hosts Found42's meeting and content workflows as tabs in one app.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/shared apps/server && tsc -p apps/web --noEmit && pnpm --filter @chief-of-staff-demo/web build",
    "typecheck": "run-p --print-label typecheck:build typecheck:web typecheck:tests",
    "typecheck:build": "tsc -b packages/shared apps/server",
    "typecheck:web": "tsc -p apps/web --noEmit",
    "typecheck:tests": "tsc -p tests --noEmit",
    "lint": "node scripts/lint-scopes.mjs",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "check": "run-p check:static test",
    "check:static": "run-p --print-label typecheck lint format:check knip",
    "check:all": "pnpm run check && pnpm run test:e2e",
    "knip": "knip",
    "dev:server": "pnpm --filter @chief-of-staff-demo/shared build && tsx watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @chief-of-staff-demo/web dev",
    "start": "node apps/server/dist/main.js",
    "test": "pnpm --filter @chief-of-staff-demo/tests test",
    "test:e2e": "pnpm run build && pnpm --filter @chief-of-staff-demo/tests test:e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,mjs,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
