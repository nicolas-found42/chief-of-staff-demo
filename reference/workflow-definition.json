      "steps": [
        {
          "stepId": "ia2vvr",
          "stepType": "ai.prompt.text",
          "title": "Write with AI",
          "adapter": "ai-text",
          "inputs": [
            {
              "input": "model",
              "type": "string",
              "value": "nvidia/nemotron-3.5-lightning"
            },
            {
              "input": "prompt",
              "type": "string",
              "value": "You are a Chief of Staff for [YOUR NAME]. Please write a first draft of a Business Plan in Google Docs.\n\nTitle of the plan: V0 Draft - Planning Doc - \n{{yk5itn_each.Business plan details.Title}}\nHere is the topic: \n{{yk5itn_each.Business plan details.Summary}}\n\nCheck the transcript for any additional context about this specific plan:\n{{trigger.File URL}}\n\nExpand on the ideas in this doc in the context of [YOUR NAME]'s business strategy, goals, objectives and key focus areas.\n\nSpecific guidance:\n- Be concise and professional\n- Use Heading 1 for key themes, Heading 2 for strategies, Heading 3 for tactics, and normal text for everything else.\n- Use tables for the following types of information: capturing risk and risk mitigation, strategic options, pros and cons, tasks\n\n[YOUR NAME]'s key focus areas for their business, [YOUR COMPANY], include the following:\n[LIST YOUR KEY FOCUS AREAS HERE, e.g.:\n1) Focus Area 1 — Description\n2) Focus Area 2 — Description\n3) Focus Area 3 — Description]\n\nKeep it under 1000 words."
            },
            {
              "input": "outputMode",
              "type": "string",
              "value": "text"
            },
            {
              "input": "reasoningEffort",
              "type": "string",
              "value": null
            },
            {
              "input": "maxTokens",
              "type": "number",
              "value": null
            }
          ],
          "outputSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "stepId": "kjlw70",
          "stepType": "docs.createDoc",
          "title": "Create document",
