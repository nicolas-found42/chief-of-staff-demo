  "name": "Chief of Staff Agent: Take Actions from Transcripts",
  "threads": [
    {
      "threadId": "main",
      "steps": [
        {
          "stepId": "trigger",
          "stepType": "drive.fileAddedToFolder",
          "title": "File added to Transcripts",
          "adapter": "trigger",
          "inputs": [
            {
              "input": "folder",
              "type": "local-directory",
              "value": "inbox/transcripts"
            }
          ],
          "outputSchema": {
            "type": "object",
            "properties": {
              "Title": {
                "type": "string"
              },
              "File URL": {
                "type": "string"
              },
              "Creation time": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "Title",
              "File URL",
              "Creation time"
            ]
          }
        },
        {
          "stepId": "eitxht",
          "stepType": "ai.prompt.object",
          "title": "Extract tasks from transcript",
          "adapter": "ai-extract",
          "inputs": [
            {
              "input": "model",
              "type": "string",
              "value": "nvidia/nemotron-3.5-lightning"
            },
            {
              "input": "prompt",
              "type": "string",
              "value": "Extract all action items and tasks assigned to [YOUR NAME] from these meeting notes. Only include tasks specifically for [YOUR NAME].\n\nDetermine if the task is an email, business plan, or other.\nCreate concise task name that is no longer than 50 characters.\n\nAll email tasks must have a deadline of today: {{system.now}}\nIf a task has a reminder/deadline date and time, output the date and time as well. If there is no task reminder/deadline date and time, or any date and time mentioned, then leave this blank.\n\nIf the task is an email, then make sure to include details on who to send it to, the subject of the email, and the body of the email in the task description.\n\nIf the task is a business plan, create a title and a summary of the business plan and include that information in the task description.\n"
            },
            {
              "input": "outputMode",
              "type": "string",
              "value": "object"
            },
            {
              "input": "reasoningEffort",
              "type": "string",
              "value": null
            },
            {
              "input": "maxTokens",
              "type": "number",
              "value": null
            }
          ],
          "userSchema": {
            "type": "array",
            "title": "Responses",
            "items": {
              "type": "object",
              "title": "Response",
              "properties": {
                "Task name": {
                  "type": "string"
                },
                "Task type": {
                  "type": "string",
                  "enum": [
                    "email",
                    "business plan",
                    "other"
                  ]
                },
                "Assigned to": {
                  "type": "string"
                },
                "Deadline": {
                  "type": "string",
                  "format": "date-time"
                },
                "Email details": {
                  "type": "object",
                  "properties": {
                    "Recipient": {
                      "type": "string"
                    },
                    "Subject": {
                      "type": "string"
                    },
                    "Body": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "Recipient",
                    "Subject",
                    "Body"
                  ]
                },
                "Business plan details": {
                  "type": "object",
                  "properties": {
                    "Title": {
                      "type": "string"
                    },
                    "Summary": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "Title",
                    "Summary"
                  ]
                },
                "Task description": {
                  "type": "string"
                }
              },
              "required": [
                "Task name",
                "Task type",
                "Assigned to"
              ]
            }
          },
          "outputSchema": {
            "type": "array",
            "items": {
              "$ref": "#/steps/eitxht/user-schema"
            }
          }
        },
        {
          "stepId": "yk5itn",
          "stepType": "iterator",
          "title": "For each task",
          "adapter": "iterator",
          "inputs": [
            {
              "input": "execution",
