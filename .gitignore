node_modules/
dist/
# Anchored: the runtime data directory is the repo root one. Unanchored, this
# also swallowed source directories named `workspace`, such as the Workspace-owned
# server namespaces.
/workspace/
.DS_Store
*.tsbuildinfo
.eslintcache
.prettiercache
playwright-report/
test-results/
blob-report/
coverage/
ACCESSIBILITY-AUDIT.md
.archive/
.firecrawl/

# Wayfinder maps and their tickets. Local planning artifacts: they record how a
# decision was reached, which the ADRs and CONTEXT.md already carry once it is.
.scratch/

# Console walkthrough captures. These contain OAuth client secrets in plaintext
# (Google shows the secret once, in a dialog people screenshot) and the account
# email. This repo is public.
screenshots/
/workspace.backup-*/

# Debrief eval fixtures: real meeting transcripts with named participants, and
# the hand-written goldens over them. Local-only — this repo is public.
tests/fixtures/debrief-golden/

# Person-research benchmark campaign output. Each dated run directory holds raw
# model output — 1,424 files and 113MB across the 2026-09-06 campaign — and is
# regenerable from `scripts/person-research-benchmark.mts`. What stays tracked is
# what something else reads: the reports directly under `artifacts/person-benchmark/`
# (including `fixed-documents-expanded-2d0a903133188b6a.json`, which three tests
# in `tests/src/modules/person-benchmark-*.test.ts` load as a fixture), and the
# diagnostics index, which `README.md` links and two research docs cite as the
# evidence for #228.
/artifacts/person-benchmark/*/
!/artifacts/person-benchmark/diagnostics-2026-09-06/
!/artifacts/person-benchmark/ambiguity-classification-2026-09-06/
!/artifacts/person-benchmark/differentials/

# Session handover notes. Local planning artifacts, same reasoning as `.scratch/`.
previous-session.md

# Per-checkout Claude Code settings: local paths and permission grants, which
# belong to this machine rather than to the project. `launch.json` is shared.
.claude/settings.local.json

# Secrets. This repo is public; nothing carrying a key is ever committed.
.env
.env.*
!.env.example

# Editor state.
.vscode/
.idea/

# pnpm's content-addressable store, when a `store-dir` puts it inside the repo.
.pnpm-store/

# Benchmark judge-response cache: local spend avoidance, never a record.
/.cache/

# Private Meeting Debrief investigation data and reports. The public repository
# retains the implementation and synthetic regressions; source transcripts,
# model requests/replies, and reports quoting those meetings stay on this machine.
/tests/fixtures/operational-handoff/*
!/tests/fixtures/operational-handoff/README.md
/docs/research/candidate-accounting-*.md
/docs/research/extraction-*.md
/docs/research/extraction-audit-2026-09-10-*/
/docs/research/mercury-timeouts-*/
