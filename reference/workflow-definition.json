            {
              "input": "notes",
              "type": "string",
              "value": "Check Inbox for v1 Email Draft: {{yk5itn_each.Email details.Subject}}\n\nLink to Draft: {{axgv0j.Draft URL}}\n\nV1 email body: {{yk5itn_each.Email details.Body}}\n\nTask from Transcript:\n{{trigger.File URL}}"
            }
          ],
          "outputSchema": {
            "type": "object",
            "properties": {
              "Task URL": {
                "type": "string"
              },
              "Task": {
                "type": "object"
              }
            },
            "required": [
